{
  "services": {
    "spark": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "outputDirectory": ".next",
      "installCommand": "npm install",
      "devCommand": "npm run dev",
      "functions": {
        "src/app/**/*.js": {
          "maxDuration": 30
        }
      },
      "rewrites": [
        {
          "source": "/robots.txt",
          "destination": "/api/robots"
        }
      ],
      "bindings": [
        {
          "type": "service",
          "service": "flint",
          "format": "url",
          "env": "FLINT_SERVICE_URL"
        }
      ]
    },
    "flint": {
      "root": "flint",
      "framework": "flask",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "includeFiles": "lab/**",
          "excludeFiles": "{.env*,**/.env*}"
        }
      }
    }
  },
  "regions": [
    "iad1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/humans.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/browserconfig.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "spark"
      }
    }
  ]
}
